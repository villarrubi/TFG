{
  "manifest_version": 3,
  "name": "Detector de Phishing para Gmail",
  "version": "1.0.0",
  "description": "Envía el correo al backend central y muestra su respuesta dentro de Gmail Web.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["server_config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
