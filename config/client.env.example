# Configuración privada de UNA instalación cliente.
# Copiar a runtime/client/.env.local y no subir el destino al repositorio.

PHISHING_BACKEND_URL=http://127.0.0.1:8766
# Credencial que el cliente presenta al administrar el backend.
BACKEND_ADMIN_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITOR_INTERVAL_SECONDS=120
PHISHING_THRESHOLD=21
MONITOR_ANALYSIS_MODE=combinado
MONITOR_HEUR_WEIGHT=45
MONITOR_NEURAL_WEIGHT=55
GMAIL_MONITOR_QUERY=in:inbox newer_than:1d
GMAIL_MONITOR_LIMIT=20
MONITOR_MARK_EXISTING_AS_SEEN=1

# Proxy histórico opcional de la extensión. La extensión actual usa 8766.
GMAIL_EXTENSION_HOST=127.0.0.1
GMAIL_EXTENSION_PORT=8765
GMAIL_EXTENSION_MODE=combinado
GMAIL_EXTENSION_THRESHOLD=21
GMAIL_EXTENSION_HEUR_WEIGHT=45
GMAIL_EXTENSION_NEURAL_WEIGHT=55

# Opcionales: permiten sacar el almacén cliente fuera del repositorio.
# GMAIL_CREDENTIALS_PATH=C:\ruta\privada\credentials.json
# GMAIL_TOKEN_PATH=C:\ruta\privada\token.json
# MONITOR_STATE_PATH=C:\ruta\privada\estado_monitor.json
