# Configuración privada del backend central.
# Copiar a runtime/server/.env.local y no subir el destino al repositorio.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8766
# Debe coincidir con la credencial de los clientes administradores.
BACKEND_ADMIN_TOKEN=
BACKEND_MODE=combinado
BACKEND_THRESHOLD=21
BACKEND_HEUR_WEIGHT=45
BACKEND_NEURAL_WEIGHT=55
BACKEND_HIGH_CONFIDENCE_THRESHOLD=70

# Valores centrales usados cuando un entrenamiento no envía una excepción.
NEURAL_NGRAM_MIN=1
NEURAL_NGRAM_MAX=2
NEURAL_MAX_FEATURES=3000
NEURAL_MIN_DF=1
NEURAL_HIDDEN_LAYERS=64,32
NEURAL_ACTIVATION=relu
NEURAL_MAX_ITER=500
NEURAL_ALPHA=0.0001
NEURAL_LEARNING_RATE=0.001
NEURAL_EARLY_STOPPING=0

# Overrides opcionales para almacenar los modelos fuera del repositorio.
# BACKEND_MODEL_ES=C:\ruta\servidor\modelo_neural_es.joblib
# BACKEND_MODEL_EN=C:\ruta\servidor\modelo_neural_en.joblib
