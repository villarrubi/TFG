# Déjalos vacíos hasta introducir credenciales reales en .env.local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITOR_INTERVAL_SECONDS=120
PHISHING_THRESHOLD=45
MONITOR_ANALYSIS_MODE=combinado
MONITOR_HEUR_WEIGHT=20
MONITOR_NEURAL_WEIGHT=80
GMAIL_MONITOR_QUERY=in:inbox newer_than:1d
GMAIL_MONITOR_LIMIT=20
MONITOR_MARK_EXISTING_AS_SEEN=1

# Backend central compartido por todos los clientes
PHISHING_BACKEND_URL=http://127.0.0.1:8766
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8766
BACKEND_ADMIN_TOKEN=
BACKEND_MODE=combinado
BACKEND_THRESHOLD=45
BACKEND_HEUR_WEIGHT=20
BACKEND_NEURAL_WEIGHT=80
BACKEND_HIGH_CONFIDENCE_THRESHOLD=70

# Proxy histórico opcional para instalaciones antiguas de la extensión.
# La extensión actual se conecta directamente al backend central (puerto 8766).
GMAIL_EXTENSION_HOST=127.0.0.1
GMAIL_EXTENSION_PORT=8765
GMAIL_EXTENSION_MODE=combinado
GMAIL_EXTENSION_THRESHOLD=45
GMAIL_EXTENSION_HEUR_WEIGHT=20
GMAIL_EXTENSION_NEURAL_WEIGHT=80
